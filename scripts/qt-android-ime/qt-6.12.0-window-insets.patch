+    private static boolean hideLandscapeStatusBar(Activity activity)
+    {
+        Configuration configuration = activity.getResources().getConfiguration();
+        return !activity.isInMultiWindowMode()
+                && configuration.orientation == Configuration.ORIENTATION_LANDSCAPE
+                && configuration.smallestScreenWidthDp < 600;
+    }
+
+    // With no layout flags, update the status bar while preserving the current window mode.
+    @SuppressWarnings("deprecation")
+    private static void updateStatusBar(Activity activity, Window window, Integer layoutFlags)
+    {
+        boolean hide = hideLandscapeStatusBar(activity);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            WindowInsetsController controller = window.getInsetsController();
+            if (controller == null)
+                return;
+
+            int statusBar = WindowInsets.Type.statusBars();
+            if (layoutFlags != null)
+                controller.show(WindowInsets.Type.systemBars() & ~statusBar);
+            controller.setSystemBarsBehavior(hide
+                    ? WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+                    : WindowInsetsController.BEHAVIOR_DEFAULT);
+            if (hide)
+                controller.hide(statusBar);
+            else
+                controller.show(statusBar);
+        } else {
+            View decor = window.getDecorView();
+            int statusFlags = View.SYSTEM_UI_FLAG_FULLSCREEN | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY;
+            int flags = layoutFlags != null ? layoutFlags : decor.getSystemUiVisibility() & ~statusFlags;
+            setSystemUiVisibility(decor, hide ? flags | statusFlags : flags);
+        }
+    }
