+
+    struct SwapchainData {
+        QRhiSwapChain *swapchain = nullptr;
+        QRhiRenderPassDescriptor *renderPassDescriptor = nullptr;
+        QObject *windowWatcher = nullptr;
+        void reset();
+    };
+
+    void resetCompositor();
