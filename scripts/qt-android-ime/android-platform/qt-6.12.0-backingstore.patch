+        QRhiTexture *lastUsedTexture = nullptr;
+        QRhiTexture *lastUsedTextureExtra = nullptr;
+        QRhiSampler::Filter lastUsedFilter = QRhiSampler::None;
+        bool isValid() const { return ubuf && srb; }
