+        // The accessibility bridge (QtAndroidAccessibility::runInObjectContext())
+        // takes the same process-wide protector before it blocks on this thread.
+        // If it got there first, the Android UI thread is currently waiting for us
+        // and the surface callback can only be delivered from that very thread, so
+        // creating the surface here would deadlock while aborting the application
+        // (qFatal) is far too brutal. Retry instead: the bridge gives up after a
+        // bounded wait (see androidjniaccessibility.cpp), after which we can go on.
+        constexpr int retryIntervalMs = 25;
+        constexpr int retryCount = 24; // ~600 ms
+        bool acquired = false;
+        for (int i = 0; i < retryCount; ++i) {
+            if (QtAndroidPrivate::acquireAndroidDeadlockProtector()) {
+                QtAndroidPrivate::releaseAndroidDeadlockProtector();
+                acquired = protector.acquire();
+                break;
+            }
+            QThread::msleep(retryIntervalMs);
+        }
+        if (!acquired) {
+            qWarning("Failed to acquire deadlock protector for %s, deferring surface creation.",
+                     funcName);
