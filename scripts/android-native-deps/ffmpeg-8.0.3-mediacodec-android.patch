+/* P010 uses a byte stride and two planes of little-endian, MSB-aligned samples. */
+static int mediacodec_copy_p010(const MediaCodecDecContext *s, const uint8_t *data, size_t size,
+                              const FFAMediaCodecBufferInfo *info, AVFrame *frame)
+{
+    if (info->offset < 0 || info->size < 0 || (size_t)info->offset > size ||
+        (size_t)info->size > size - (size_t)info->offset ||
+        s->stride <= 0 || s->slice_height < s->height ||
+        s->crop_left < 0 || s->crop_top < 0 || ((s->crop_left | s->crop_top) & 1))
+        return AVERROR_INVALIDDATA;
+
+    data += info->offset;
+    const size_t left = (size_t)s->crop_left * 2;
+    for (int plane = 0; plane < 2; plane++) {
+        const int rows = plane ? AV_CEIL_RSHIFT(frame->height, 1) : frame->height;
+        const size_t bytes = plane ? (size_t)AV_CEIL_RSHIFT(frame->width, 1) * 4 : (size_t)frame->width * 2;
+        const uint64_t top = plane ? (uint64_t)s->slice_height + s->crop_top / 2 : (uint64_t)s->crop_top;
+        const uint64_t offset = top * (unsigned)s->stride + left;
+        if (rows <= 0 || bytes > INT_MAX || left + bytes > (size_t)s->stride ||
+            offset + (uint64_t)(rows - 1) * (unsigned)s->stride + bytes > (size_t)info->size)
+            return AVERROR_INVALIDDATA;
+        av_image_copy_plane(frame->data[plane], frame->linesize[plane], data + offset,
+                            s->stride, (int)bytes, rows);
+    }
+    return 0;
+}
